{
	"name": "KaggleToRaw",
	"properties": {
		"activities": [
			{
				"name": "DownloadKaggleAdventureWorks",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "TruncateAdventureWorksKaggle",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "BinaryReadSettings",
							"compressionProperties": {
								"type": "ZipDeflateReadSettings"
							}
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false,
					"logSettings": {
						"enableCopyActivityLog": true,
						"copyActivityLogSettings": {
							"logLevel": "Warning",
							"enableReliableLogging": false
						},
						"logLocationSettings": {
							"linkedServiceName": {
								"referenceName": "storageaccountswec001",
								"type": "LinkedServiceReference"
							},
							"path": "metadata"
						}
					}
				},
				"inputs": [
					{
						"referenceName": "KaggleAdventureWorksZIP",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "adventureworkskaggle",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "TruncateAdventureWorksKaggle",
				"type": "Delete",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "adventureworkskaggle",
						"type": "DatasetReference"
					},
					"logStorageSettings": {
						"linkedServiceName": {
							"referenceName": "storageaccountswec001",
							"type": "LinkedServiceReference"
						},
						"path": "metadata"
					},
					"enableLogging": true,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			},
			{
				"name": "ForEachFiles",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get_files_adventureworkskaggle_zipfolder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get_files_adventureworkskaggle_zipfolder').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "adventureworkskaggleCSV_dynamic_source",
									"type": "DatasetReference",
									"parameters": {
										"p_source_folder": {
											"value": "@variables('v_folder_source')",
											"type": "Expression"
										},
										"p_source_file": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "adventureworkskaggleCSV_dynamic_sink",
									"type": "DatasetReference",
									"parameters": {
										"p_sink_folder": {
											"value": "@pipeline().parameters.p_source_folder",
											"type": "Expression"
										},
										"p_sink_file": "@item().name"
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "get_adventureworkskaggle_zipfolder",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "DownloadKaggleAdventureWorks",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "adventureworkskaggleCSV_dynamic_source",
						"type": "DatasetReference",
						"parameters": {
							"p_source_folder": {
								"value": "@concat('bronze', '/', pipeline().parameters.p_source_folder)",
								"type": "Expression"
							},
							"p_source_file": {
								"value": "@null",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "set_v_folder_source",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "get_adventureworkskaggle_zipfolder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_folder_source",
					"value": {
						"value": "@concat(pipeline().parameters.p_source_folder, '/', activity('get_files_adventureworkskaggle_zipfolder').output.childItems[0].name)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "get_files_adventureworkskaggle_zipfolder",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "set_v_folder_source",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "adventureworkskaggleCSV_dynamic_source",
						"type": "DatasetReference",
						"parameters": {
							"p_source_folder": {
								"value": "@variables('v_folder_source')",
								"type": "Expression"
							},
							"p_source_file": "@item"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"concurrency": 4,
		"parameters": {
			"p_source_folder": {
				"type": "string",
				"defaultValue": "adventureworkskaggle"
			}
		},
		"variables": {
			"xyz": {
				"type": "String"
			},
			"v_folder_source": {
				"type": "String"
			}
		},
		"annotations": []
	}
}