					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "TransformJSON",
						"type": "DataFlowReference"
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"variables": {
			"p_filename": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-10T09:43:29Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}